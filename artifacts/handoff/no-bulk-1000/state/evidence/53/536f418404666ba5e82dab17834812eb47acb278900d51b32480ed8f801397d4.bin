-16","type":"Aksjekapital","valuta":"NOK"},"konkurs":false,"maalform":"Bokmål","naeringskode1":{"beskrivelse":"Utvikling og salg av byggeprosjekter","kode":"68.120"},"navn":"SELTANGEN HYTTEFELT AS","organisasjonsform":{"_links":{"self":{"href":"https://data.brreg.no/enhetsregisteret/api/organisasjonsformer/AS"}},"beskrivelse":"Aksjeselskap","kode":"AS"},"organisasjonsnummer":"925972436","paategninger":[],"registreringsdatoEnhetsregisteret":"2020-11-16","registreringsdatoForetaksregisteret":"2020-11-16","registrertIForetaksregisteret":true,"registrertIFrivillighetsregisteret":false,"registrertIMvaregisteret":false,"registrertIPartiregisteret":false,"registrertIStiftelsesregisteret":false,"respons_klasse":"Enhet","sisteInnsendteAarsregnskap":"2025","stiftelsesdato":"2020-10-27","underAvvikling":false,"underTvangsavviklingEllerTvangsopplosning":false,"vedtektsdato":"2020-10-27","vedtektsfestetFormaal":["Utvikling, salg, drift og utleie relatert til fritidseiendom, og det","som står i forbindelse med dette, herunder å delta i andre selskaper","med slikt formål."]},{"_links":{"self":{"href":"https://data.brreg.no/enhetsregisteret/api/enheter/924897856"}},"aktivitet":["Direkte, eller ved eierskap i aksjer, legge vekt på å skaffe kommunens","innbyggere og næringsliv sikre strømleveranser til riktige priser.","Virksomheten kan tilrettelegge for, delta i eller stå for utvikling av","aktiviteter som gir styrket energileveranse, ved kraftutbygging,","utbygging av fjernvarme e.l. Videre kan selskapet drive med omsetning","av elektrisk energi utenfor eget konsesjonsområde med forsiktighet.","Selskapet kan forvalte eller være avtaker av kommunens","konsesjonskraft. Selskapet skal gi inntjening på sin virksomhet og","kapital som sikrer virksomhetens drift. Virksomhetens økonomiske","målsettinger skal være basert på sikkerhet og ivaretakelse av","eksisterende og fremtidige verdier som finnes i virksomheten. Ved","samarbeid med andre selskaper og organisasjoner skal en ivareta","selskapets selvstendighet. Selskapet skal ta hensyn til lokale","arbeidsplasser i sin organisasjon. Det skal legges vekt på å bygge opp","arbeidsplasser basert på kompetanse, ansvar og trivsel gjennom et","aktivt HMS-arbeid. Selskapet skal direkte eller indirekte drive aktiv","energiøkonomisering. Denne virksomheten skal bidra til å markedsføre","selskapet på en positiv måte både overfor private, offentlige og","næringslivskunder. Selskapet skal til enhver tid vurdere salg av","tjenester innenfor sitt fagkompetanseområde. Dette skal styrke","selskapet økonomisk og kompetansemessig."],"erIKonsern":false,"forretningsadresse":{"adresse":["Mongstugata 9"],"kommune":"SUNNDAL","kommunenummer":"1563","land":"Norge","landkode":"NO","postnummer":"6600","poststed":"SUNNDALSØRA"},"harRegistrertAntallAnsatte":true,"historiskeNavn":[],"hjelpeenhetskode":{"beskrivelse":"Hovedkontortjenester","kode":"70.100"},"institusjonellSektorkode":{"beskrivelse":"Kommunalt eide aksjeselskaper mv.","kode":"1520"},"kapital":{"antallAksjer":80867975,"belop":80867975.00,"innfortDato":"2020-04-03","type":"Aksjekapital","valuta":"NOK"},"konkurs":false,"maalform":"Bokmål","naeringskode1":{"beskrivelse":"Handel med elektrisitet","kode":"35.150"},"navn":"SUNNDAL ENERGI HOLDING AS","organisasjonsform":{"_links":{"self":{"href":"https://data.brreg.no/enhetsregisteret/api/organisasjonsformer/AS"}},"beskrivelse":"Aksjeselskap","kode":"AS"},"organisasjonsnummer":"924897856","paategninger":[],"registreringsdatoAntallAnsatteEnhetsregisteret":"2024-11-16","registreringsdatoAntallAnsatteNAVAaregisteret":"2024-11-10","registreringsdatoEnhetsregisteret":"2020-04-03","registreringsdatoForetaksregisteret":"2020-04-03","registreringsdatoMerverdiavgiftsregisteret":"2020-09-01","registreringsdatoMerverdiavgiftsregisteretEnhetsregisteret":"2020-09-05","registrertIForetaksregisteret":true,"registrertIFrivillighetsregisteret":false,"registrertIMvaregisteret":true,"registrertIPartiregisteret":false,"registrertIStiftelsesregisteret":false,"respons_klasse":"Enhet","sisteInnsendteAarsregnskap":"2025","stiftelsesdato":"2020-03-16","underAvvikling":false,"underTvangsavviklingEllerTvangsopplosning":false,"vedtektsdato":"2025-05-08","vedtektsfestetFormaal":["Direkte eller indirekte sikre effektiv produksjon, transport og","omsetning av energi og bredbåndstjenester og delta i annen naturlig","tilhørende virksomhet. Bidra til en sikker og rasjonell energi- og","bredbåndsforsyning, gjennom eierskap i selskaper og sammenslutninger","som driver nærliggende virksomhet. Selskapet skal også kunne yte lån","og stille sikkerhet for selskaper som konsernet har eierposisjon i.","Videre skal selskapet kunne eie og forvalte fast eiendom, samt yte","administrative tjenester til andre selskaper i konsernet. Samarbeid","med andre selskaper og organisasjoner skal hensynta selskapets","selvstendighet."]},{"_links":{"self":{"href":"https://data.brreg.no/enhetsregisteret/api/enheter/917183392"}},"aktivitet":["Gje ut avisa  og det som står i samband med dette,","samt ta del i andre selskap. Avisa skal vere","partipolitisk ubunden, vere ein tillitsskapande","bindelekk over kommunegrensene i regionen og","avspegle den pågåande samfunnsdebatten. Hovudvekta","av stoffet skal vere frå primærområda","Ulstein og Hareid.","Selskapet skal drivast på ein slik måte at det gir","økonokisk overskot, dette for å trygge arbeids-","plassane og skape verdiar for eigarane."],"antallAnsatte":9,"erIKonsern":true,"forretningsadresse":{"adresse":["Sjøgata 34"],"kommune":"ULSTEIN","kommunenummer":"1516","land":"Norge","landkode":"NO","postnummer":"6065","poststed":"ULSTEINVIK"},"frivilligMvaRegistrertBeskrivelser":["Utleier av bygg eller anlegg"],"harRegistrertAntallAnsatte":true,"historiskeNavn":[],"institusjonellSektorkode":{"beskrivelse":"Private aksjeselskaper mv.","kode":"2100"},"kapital":{"antallAksjer":1500000,"belop":1329534.00,"innfortDato":"2023-03-01","type":"Aksjekapital","valuta":"NOK"},"konkurs":false,"maalform":"Nynorsk"