al ta hensyn til lokale arbeidsplasser i sin organisasjon. Det skal legges vekt på å bygge opp arbeidsplasser basert på kompetanse, ansvar og trivsel gjennom et aktivt HMS-arbeid. Selskapet skal direkte eller indirekte drive aktiv energiøkonomisering. Denne virksomheten skal bidra til å markedsføre selskapet på en positiv måte både overfor private, offentlige og næringslivskunder. Selskapet skal til enhver tid vurdere salg av tjenester innenfor sitt fagkompetanseområde. Dette skal styrke selskapet økonomisk og kompetansemessig.","erIKonsern":false,"forretningsadresse":{"adresse":"Mongstugata 9","kommune":"SUNNDAL","kommunenummer":"1563","land":"Norge","landkode":"NO","postnummer":"6600","poststed":"SUNNDALSØRA"},"harRegistrertAntallAnsatte":true,"hjelpeenhetskode":{"beskrivelse":"Hovedkontortjenester","kode":"70.100"},"institusjonellSektorkode":{"beskrivelse":"Kommunalt eide aksjeselskaper mv.","kode":"1520"},"kapital":{"antallAksjer":"80867975","belop":"80867975.00","innfortDato":"2020-04-03","type":"Aksjekapital","valuta":"NOK"},"konkurs":false,"maalform":"Bokmål","naeringskode1":{"beskrivelse":"Handel med elektrisitet","kode":"35.150"},"navn":"SUNNDAL ENERGI HOLDING AS","organisasjonsform":{"beskrivelse":"Aksjeselskap","kode":"AS"},"organisasjonsnummer":"924897856","paategninger":false,"registreringsdatoAntallAnsatteEnhetsregisteret":"2024-11-16","registreringsdatoEnhetsregisteret":"2020-04-03","registreringsdatoForetaksregisteret":"2020-04-03","registreringsdatoMerverdiavgiftsregisteret":"2020-09-01","registreringsdatoMerverdiavgiftsregisteretEnhetsregisteret":"2020-09-05","registreringsdatoantallansatteNAVAaregisteret":"2024-11-10","registrertIForetaksregisteret":true,"registrertIFrivillighetsregisteret":false,"registrertIMvaRegisteret":true,"registrertIPartiregisteret":false,"registrertIStiftelsesregisteret":false,"sisteInnsendteAarsregnskap":"2025","stiftelsesdato":"2020-03-16","underAvvikling":false,"underTvangsavviklingEllerTvangsopplosning":false,"vedtekts